# OKP MCP server (connects to Solr over the shared network).

[Unit]
Description=OKP MCP server
After=okp-solr.service
Requires=okp-solr.service

[Container]
Image=quay.io/redhat-services-prod/rhel-lightspeed-tenant/rhel-knowledge-bridge:latest
ContainerName=okp-mcp
Network=okp.network
PublishPort=8000:8000

Environment=MCP_TRANSPORT=streamable-http
Environment=MCP_SOLR_URL=http://okp-solr:8983
AutoUpdate=registry

[Service]
# always, not on-failure: the server traps SIGTERM and exits 0, which
# on-failure treats as success and declines to restart.
Restart=always

[Install]
WantedBy=default.target
